if(NOT EXISTS "${TS_CLANG_FORMAT}")
    message(FATAL_ERROR "Set TS_CLANG_FORMAT to clang-format 22 or later")
endif()
file(GLOB_RECURSE sources LIST_DIRECTORIES false
    "${TS_SOURCE_ROOT}/src/*" "${TS_SOURCE_ROOT}/include/*"
    "${TS_SOURCE_ROOT}/tests/*" "${TS_SOURCE_ROOT}/tools/*"
    "${TS_SOURCE_ROOT}/third_party/*")
list(FILTER sources INCLUDE REGEX "\\.(cpp|hpp|c|h|cc|cxx|hh|hxx|mm|m|cu|cuh)$")
list(FILTER sources EXCLUDE REGEX "/third_party/llama/vendor/")
if(TS_FORMAT_CHECK)
    set(flags --dry-run --Werror)
else()
    set(flags -i)
endif()
while(sources)
    list(LENGTH sources remaining)
    if(remaining GREATER 50)
        set(count 50)
    else()
        set(count ${remaining})
    endif()
    list(SUBLIST sources 0 ${count} batch)
    execute_process(COMMAND "${TS_CLANG_FORMAT}" ${flags} ${batch} COMMAND_ERROR_IS_FATAL ANY)
    if(remaining GREATER count)
        list(SUBLIST sources ${count} -1 sources)
    else()
        set(sources)
    endif()
endwhile()
