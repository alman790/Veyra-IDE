if(NOT EXISTS "${TS_EXECUTABLE}")
    message(FATAL_ERROR "Build VeyraIDE first")
endif()
file(MAKE_DIRECTORY "${TS_OUTPUT}")
file(REMOVE "${TS_OUTPUT}/tools/debug_bridge.py" "${TS_OUTPUT}/share/VeyraIDE/tools/debug_bridge.py")
if(APPLE)
    string(SHA256 buildKey "${TS_OUTPUT}")
    string(SUBSTRING "${buildKey}" 0 12 buildKey)
    if(DEFINED ENV{TMPDIR})
        set(stage "$ENV{TMPDIR}/veyra-deploy-${buildKey}")
    else()
        set(stage "/tmp/veyra-deploy-${buildKey}")
    endif()
    file(MAKE_DIRECTORY "${stage}")
    set(bundle "${stage}/VeyraIDE.app")
    file(REMOVE_RECURSE "${bundle}")
    get_filename_component(sourceBundle "${TS_BUNDLE}" REALPATH)
    file(COPY "${sourceBundle}" DESTINATION "${stage}")
    get_filename_component(qtbin "${TS_QMAKE}" DIRECTORY)
    execute_process(COMMAND "${TS_QMAKE}" -query QT_INSTALL_PLUGINS OUTPUT_VARIABLE plugins OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    file(MAKE_DIRECTORY "${bundle}/Contents/PlugIns/platforms")
    get_filename_component(cocoa "${plugins}/platforms/libqcocoa.dylib" REALPATH)
    file(COPY "${cocoa}" DESTINATION "${bundle}/Contents/PlugIns/platforms")
    set(deployArgs "${bundle}" -no-strip -no-plugins -no-codesign "-executable=${bundle}/Contents/PlugIns/platforms/libqcocoa.dylib")
    foreach(format qjpeg qgif qsvg)
        if(EXISTS "${plugins}/imageformats/lib${format}.dylib")
            file(MAKE_DIRECTORY "${bundle}/Contents/PlugIns/imageformats")
            get_filename_component(imagePlugin "${plugins}/imageformats/lib${format}.dylib" REALPATH)
            file(COPY "${imagePlugin}" DESTINATION "${bundle}/Contents/PlugIns/imageformats")
            list(APPEND deployArgs "-executable=${bundle}/Contents/PlugIns/imageformats/lib${format}.dylib")
        endif()
    endforeach()
    execute_process(COMMAND "${qtbin}/macdeployqt" ${deployArgs} COMMAND_ERROR_IS_FATAL ANY)
    if(DEFINED TS_LICENSE_DIRECTORY AND EXISTS "${TS_LICENSE_DIRECTORY}")
        file(COPY "${TS_LICENSE_DIRECTORY}/" DESTINATION "${bundle}/Contents/Resources/licenses")
        file(COPY "${TS_LICENSE_DIRECTORY}/../LICENSE" DESTINATION "${bundle}/Contents/Resources/licenses")
    endif()
    file(GLOB_RECURSE appleDoubleFiles LIST_DIRECTORIES false "${bundle}/._*")
    if(appleDoubleFiles)
        file(REMOVE ${appleDoubleFiles})
    endif()
    execute_process(COMMAND xattr -cr "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --force --deep --sign - "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --verify --deep --strict "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND ditto -c -k --keepParent --noextattr --norsrc "${bundle}" "${TS_OUTPUT}/VeyraIDE-macOS.zip" COMMAND_ERROR_IS_FATAL ANY)
    set(archiveCheck "${stage}/archive-check")
    file(REMOVE_RECURSE "${archiveCheck}")
    execute_process(COMMAND ditto -x -k "${TS_OUTPUT}/VeyraIDE-macOS.zip" "${archiveCheck}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --verify --deep --strict "${archiveCheck}/VeyraIDE.app" COMMAND_ERROR_IS_FATAL ANY)
    file(REMOVE_RECURSE "${archiveCheck}")
    file(REMOVE_RECURSE "${TS_OUTPUT}/VeyraIDE.app")
    execute_process(COMMAND ditto --noextattr --norsrc "${bundle}" "${TS_OUTPUT}/VeyraIDE.app" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --verify --deep --strict "${TS_OUTPUT}/VeyraIDE.app" RESULT_VARIABLE copiedSignature ERROR_VARIABLE copiedError)
    if(NOT copiedSignature EQUAL 0)
        if(copiedError MATCHES "resource fork|Finder information")
            message(WARNING "File Provider attached Finder metadata to the copied bundle. The signed ZIP was created before this metadata and remains the distribution artifact. ${copiedError}")
        else()
            message(FATAL_ERROR "Copied application signature failed: ${copiedError}")
        endif()
    endif()
    file(REMOVE_RECURSE "${bundle}")
elseif(WIN32)
    get_filename_component(qtbin "${TS_QMAKE}" DIRECTORY)
    file(COPY "${TS_EXECUTABLE}" DESTINATION "${TS_OUTPUT}")
    get_filename_component(binaryDir "${TS_EXECUTABLE}" DIRECTORY)
    if(TS_LOCAL_MODEL)
        file(COPY "${binaryDir}/models" DESTINATION "${TS_OUTPUT}")
    endif()
    if(EXISTS "${TS_LICENSE_DIRECTORY}")
        file(COPY "${TS_LICENSE_DIRECTORY}" DESTINATION "${TS_OUTPUT}")
        file(COPY "${TS_LICENSE_DIRECTORY}/../LICENSE" DESTINATION "${TS_OUTPUT}")
    endif()
    execute_process(COMMAND "${qtbin}/windeployqt.exe" --no-translations --compiler-runtime "${TS_OUTPUT}/VeyraIDE.exe" COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${TS_BUILD_DIRECTORY}" --config "${TS_CONFIGURATION}" --prefix "${TS_OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
endif()
message(STATUS "Staged native application in ${TS_OUTPUT}. Distribution signing/notarization is separate.")
