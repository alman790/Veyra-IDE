if(NOT APPLE)
    message(FATAL_ERROR "This installer target creates macOS DMG/PKG. On Windows use CPack with NSIS when available.")
endif()
if(NOT EXISTS "${TS_OUTPUT}/VeyraIDE-macOS.zip")
    message(FATAL_ERROR "Run the deploy target first")
endif()
string(SHA256 key "${TS_OUTPUT}")
string(SUBSTRING "${key}" 0 12 key)
set(stage "$ENV{TMPDIR}/veyra-installer-${key}.noindex")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/payload" "${stage}/disk")
execute_process(COMMAND ditto -x -k "${TS_OUTPUT}/VeyraIDE-macOS.zip" "${stage}/payload" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND codesign --verify --deep --strict "${stage}/payload/VeyraIDE.app" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND ditto --noextattr --norsrc "${stage}/payload/VeyraIDE.app" "${stage}/disk/VeyraIDE.app" COMMAND_ERROR_IS_FATAL ANY)
file(CREATE_LINK "/Applications" "${stage}/disk/Applications" SYMBOLIC)
file(WRITE "${stage}/disk/.metadata_never_index" "")
file(WRITE "${stage}/disk/Install.txt" "Veyra IDE ${TS_VERSION}\n\nDrag VeyraIDE.app to Applications.\nArchitecture: ${TS_ARCH}. Minimum macOS: ${TS_MIN_OS} (or the Qt runtime minimum). Developer ID signing/notarization is not included.\nCompilers and language servers are installed separately; Settings shows their status.\n\nПеретащите VeyraIDE.app в Applications.\nАрхитектура: ${TS_ARCH}. Минимальная macOS: ${TS_MIN_OS} (с учётом требований Qt). Подпись Developer ID и notarization отсутствуют.\nКомпиляторы и языковые серверы устанавливаются отдельно; их состояние показано в настройках.\n")
foreach(attempt RANGE 1 3)
    execute_process(COMMAND hdiutil create -volname "Veyra IDE" -srcfolder "${stage}/disk"
        -fs HFS+ -format UDZO -ov "${TS_OUTPUT}/VeyraIDE-${TS_VERSION}-${TS_ARCH}.dmg"
        RESULT_VARIABLE dmgResult OUTPUT_VARIABLE dmgOutput ERROR_VARIABLE dmgError)
    if(dmgResult EQUAL 0)
        break()
    endif()
    if(NOT dmgError MATCHES "Resource busy" OR attempt EQUAL 3)
        message(FATAL_ERROR "Disk image creation failed: ${dmgError}")
    endif()
    message(STATUS "Disk image device is busy; retrying creation")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
endforeach()
file(WRITE "${stage}/components.plist" "<?xml version=\"1.0\" encoding=\"UTF-8\"?><!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\"><plist version=\"1.0\"><array><dict><key>BundleHasStrictIdentifier</key><true/><key>BundleIsRelocatable</key><false/><key>BundleIsVersionChecked</key><true/><key>BundleOverwriteAction</key><string>upgrade</string><key>RootRelativeBundlePath</key><string>VeyraIDE.app</string></dict></array></plist>")
execute_process(COMMAND pkgbuild --component-plist "${stage}/components.plist" --root "${stage}/payload" --install-location /Applications --identifier org.veyra.ide --version "${TS_VERSION}" "${TS_OUTPUT}/VeyraIDE-${TS_VERSION}-${TS_ARCH}.pkg" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE_RECURSE "${stage}")
message(STATUS "Created DMG and unsigned PKG installers in ${TS_OUTPUT}")
