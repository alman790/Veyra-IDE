{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TS_BUILD_GUI": "ON",
        "TS_REQUIRE_GUI": "ON",
        "TS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/linux"
    },
    {
      "name": "macos",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/macos"
    },
    {
      "name": "windows",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/windows"
    }
  ],
  "buildPresets": [
    {"name": "linux", "configurePreset": "linux", "jobs": 4},
    {"name": "macos", "configurePreset": "macos", "jobs": 4},
    {"name": "windows", "configurePreset": "windows", "configuration": "Release", "jobs": 4},
    {"name": "linux-installer", "configurePreset": "linux", "targets": ["installer"]},
    {"name": "macos-installer", "configurePreset": "macos", "targets": ["installer"]},
    {"name": "windows-installer", "configurePreset": "windows", "configuration": "Release", "targets": ["installer"]}
  ],
  "testPresets": [
    {"name": "linux", "configurePreset": "linux", "output": {"outputOnFailure": true}},
    {"name": "macos", "configurePreset": "macos", "output": {"outputOnFailure": true}},
    {"name": "windows", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
